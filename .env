# ---------------------------------------------------------------------------
# Public site URL — used for canonical URLs, sitemap and Open Graph metadata.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://saloonitransporthub.in

# ---------------------------------------------------------------------------
# Business contact details — shown across the whole website (header, footer,
# call/WhatsApp buttons, enquiry messages, contact page, Google data).
# Change them here and restart `npm run dev` (or push to redeploy).
# This file is committed to git — never put secrets (API keys, passwords)
# here; add those in Vercel → Settings → Environment Variables instead.
# ---------------------------------------------------------------------------
# Call number, with country code.
NEXT_PUBLIC_PHONE_NUMBER=+918219769045
# WhatsApp number, with country code. Leave empty to use the call number.
NEXT_PUBLIC_WHATSAPP_NUMBER=918219769045
NEXT_PUBLIC_CONTACT_EMAIL=bookings@himachalridehub.in

# Business address. Leave POSTAL_CODE empty until you have confirmed it.
NEXT_PUBLIC_ADDRESS_LINE1=Vehicle Booking Desk
NEXT_PUBLIC_ADDRESS_CITY=Salooni
NEXT_PUBLIC_ADDRESS_DISTRICT=Chamba
NEXT_PUBLIC_ADDRESS_STATE=Himachal Pradesh
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=176320

# ---------------------------------------------------------------------------
# Future backend integration (not required for the current site).
# The frontend is structured so these can be added without refactoring.
# ---------------------------------------------------------------------------

# Database connection for admin dashboard / booking management
# DATABASE_URL=

# WhatsApp Business API — for automated booking notifications
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Transactional email for booking confirmations
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# Admin authentication
# AUTH_SECRET=

# Payment gateway (if online payment is added later)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
