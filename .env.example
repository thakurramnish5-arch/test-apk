# Server-only secrets. Copy to .env.local for local testing and add the same
# values in Vercel → Settings → Environment Variables. Never put real values
# in .env (it is committed to git) or in any NEXT_PUBLIC_* variable.

# Enquiry email (existing)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ENQUIRY_EMAIL_TO=

# WhatsApp Cloud API — enquiry confirmation sent to the customer
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=107411178994968
# Optional (defaults shown)
# WHATSAPP_TEMPLATE_NAME=enquiry_received
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_API_VERSION=v23.0

# Meta app + Embedded Signup (WhatsApp Business app coexistence)
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=

# Any long random string; the same value goes in App Dashboard → WhatsApp →
# Configuration → Verify token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Any long random string; opens /admin/whatsapp-connect?key=<value>
ADMIN_CONNECT_SECRET=
